FIRECRAWL_API_KEY=fc-your-api-key
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
NEXT_PUBLIC_SUPABASE_URL=https://czxrhuuopbcujyeryxml.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional acquisition integrations. See ACQUISITION_SETUP.md.
# Server-only Treg token. Never expose this as NEXT_PUBLIC_*.
TREG_TOKEN=
# Optional for identity tokens; team/agent tokens already contain the org.
TREG_ORG=
# Maximum USD Treg may spend on one routed call (default: 0.25, max: 10).
TREG_MAX_COST_USD=0.25
# Legacy fallback when TREG_TOKEN is not configured.
EXPLEE_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
OUTREACH_FROM=
OUTREACH_POSTAL_ADDRESS=
# Comma-separated Supabase user IDs explicitly allowed to use this sending mailbox.
OUTREACH_ALLOWED_USER_IDS=
